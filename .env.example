# Copy to .env.local for local development. None of these values are secret.
# For the GitHub Pages build, set the same names as repository variables.

# Repository that holds data/games.json and data/journal.json
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=backlogtracker
VITE_GITHUB_BRANCH=main

# IGDB is not used by the app. Games are added from IGDB by the "Add game from IGDB"
# workflow, whose credentials are GitHub Actions secrets (see README).
